# ---------- Core ----------
TZ=Asia/Jakarta
POSTGRES_USER=pw
POSTGRES_PASSWORD=pw_local_dev
# openssl rand -hex 24
N8N_ENCRYPTION_KEY=change-me
# Shared secret between the dashboard proxy and the n8n API webhooks. openssl rand -hex 16
PW_API_TOKEN=change-me

# ---------- LLM bridge (host process, `npm run bridge`) ----------
LLM_BRIDGE_URL=http://host.docker.internal:8787
LLM_BRIDGE_TOKEN=change-me
# cli = use your local `claude` login | api = Anthropic Messages API (needs ANTHROPIC_API_KEY)
LLM_BACKEND=cli
LLM_MODEL_WRITER=sonnet
LLM_MODEL_REVIEWER=haiku
# ANTHROPIC_API_KEY=

# ---------- Facebook / Instagram ----------
# Leave blank while settings.dry_run = true. See docs/facebook-setup.md
FB_GRAPH_VERSION=v24.0
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
IG_USER_ID=

# ---------- Alerts ----------
# Optional Slack/Discord-compatible incoming webhook. Alerts always land on the dashboard.
ALERT_WEBHOOK_URL=

# ---------- Content source ----------
PW_BASE_URL=https://www.placidway.com
PW_USER_AGENT="PlacidWaySocialAutopilot/1.0 (+assessment demo; 1 req/s max)"
# UTM tags appended to the link in each post (blank to disable)
PW_UTM="utm_source=facebook&utm_medium=social&utm_campaign=pw_daily_autopilot"
