      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Normalize FB Response: /feed returns {id: \"<page>_<post>\"}.\nconst p = $('Attach Media').item.json;\nconst r = $json;\nif (!r.id) throw new Error(`Facebook returned no post id: ${JSON.stringify(r).slice(0, 300)}`);\nreturn { json: { ...p, fb_post_id: r.id, status: p.scheduled ? 'scheduled' : 'published' } };\n",
        "mode": "runOnceForEachItem"
      },
