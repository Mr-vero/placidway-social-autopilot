          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "9182a871-0e79-49f0-a82c-c3beda8fa0ec",
              "leftValue": "={{ $('Prepare Publish').item.json.dry_run }}",
              "rightValue": "",
              "operator": {
