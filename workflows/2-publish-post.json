    {
      "parameters": {
        "jsCode": "// IG Result: record the Instagram cross-post (best effort, never blocks Facebook).\nconst p = $('Add Permalink').item.json;\nconst r = $json;\nif (r.id && !r.error) return { json: { ...p, ig_media_id: r.id } };\nreturn {\n  json: {\n    ...p,\n    alert: { severity: 'warning', source: 'instagram', message: `Instagram cross-post failed for post #${p.post_id} (Facebook post is live)`, details: JSON.stringify(r.error || r).slice(0, 1500) },\n  },\n};\n",
        "mode": "runOnceForEachItem"
      },
      "id": "af94b7df-ab60-48d4-a4ef-4f001d0a19d2",
      "name": "IG Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
