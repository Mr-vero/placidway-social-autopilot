        }
      },
      "id": "863bbcdc-483e-45b0-aec5-f479dcd502dd",
      "name": "FB Create Post",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2240,
        140
      ],
      "retryOnFail": true,
