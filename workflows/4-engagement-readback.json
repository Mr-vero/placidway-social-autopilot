      "id": "ca996fa2-f861-49dd-a22e-b94e1cfe3fae",
      "name": "Read Counts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        380
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Normalize Engagement: Graph insights (+ optional counts) -> one snapshot row per post.\n// Insights work with pages_read_engagement. The comments/shares fields need\n// pages_read_user_content; without it that call fails and those stay null.\nconst posts = $('Published Posts').all();\nconst insights = $('Read Insights').all();\nconst out = [];\n$input.all().forEach((countsItem, i) => {\n  const post = posts[i] ? posts[i].json : null;\n  if (!post) return;\n  const ins = (insights[i] && insights[i].json) || {};\n  const counts = countsItem.json || {};\n  const metric = (name) => ((ins.data || []).find((d) => d.name === name) || {}).values?.[0]?.value;\n\n  const byType = metric('post_reactions_by_type_total');\n  const reactionsFromInsights = byType && typeof byType === 'object' ? Object.values(byType).reduce((s, n) => s + Number(n || 0), 0) : null;\n  const reactions = counts.reactions?.summary?.total_count ?? reactionsFromInsights ?? (ins.data ? 0 : null);\n  const row = {\n    post_id: post.id,\n    reactions,\n    comments: counts.comments?.summary?.total_count ?? null,\n    shares: counts.error ? null : (counts.shares?.count ?? 0),\n    clicks: metric('post_clicks') ?? (ins.data ? 0 : null),\n    views: metric('post_media_view') ?? null,\n  };\n  // Nothing readable at all (both calls failed): skip rather than store a fake zero.\n  if (ins.error && counts.error) return;\n  out.push({ json: { ...row, raw: JSON.stringify({ insights: ins.data || ins.error || null, counts: counts.error ? { error: String(counts.error.message || counts.error).slice(0, 300) } : counts }).slice(0, 4000) } });\n});\nreturn out;\n"
      },
      "id": "ec7180fc-b6f1-458a-ac42-6c4c3b67b3ba",
      "name": "Normalize Engagement",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        380
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO engagement (post_id, reactions, comments, shares, clicks, views, raw) VALUES ($1, $2, $3, $4, $5, $6, $7::jsonb)",
        "options": {
          "queryReplacement": "={{ [ $json.post_id, $json.reactions, $json.comments, $json.shares, $json.clicks, $json.views, $json.raw ] }}"
        }
      },
